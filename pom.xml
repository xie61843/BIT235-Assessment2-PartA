<?xml version="1.0" encoding="UTF-8"?>
<!--
  BIT235 Assessment 2 - Part A: Wiki Administrator Login
  Student: Xinle Xie - S1580929
  Project object model: declares the Spring Boot parent, the Java version and
  the three starters needed for an MVC web application with validated forms.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>com.mp.bit235</groupId>
    <artifactId>wiki-admin-login</artifactId>
    <version>1.0.0</version>
    <name>wiki-admin-login</name>
    <description>BIT235 Assessment 2 Part A - Wiki administrator login (MVC)</description>

    <properties>
        <java.version>11</java.version>
    </properties>

    <dependencies>
        <!-- Spring MVC, embedded Tomcat and Jackson for the web layer. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Server-side rendering of the login, welcome and error pages. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <!-- Bean Validation used by the LoginForm model. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Test scope only; no production dependency is added. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Produces an executable jar and enables "mvn spring-boot:run". -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
